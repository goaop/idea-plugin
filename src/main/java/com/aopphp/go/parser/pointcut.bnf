{
  parserClass="com.aopphp.go.parser.PointcutParser"

  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix=""
  psiImplClassSuffix="Impl"
  psiPackage="com.aopphp.go.psi"
  psiImplPackage="com.aopphp.go.psi.impl"
  psiImplUtilClass="com.aopphp.go.psiutil.PointcutPsiUtil"

  elementTypeHolderClass="com.aopphp.go.psi.PointcutTypes"
  elementTypeClass="com.aopphp.go.psiutil.PointcutElementType"
  tokenTypeClass="com.aopphp.go.psiutil.PointcutTokenType"

  tokens=[
    T_NS_SEPARATOR='\'
    T_ANNOTATION='@'
    T_LEFT_PAREN='('
    T_RIGHT_PAREN=')'
    T_OBJECT_ACCESS='->'
    T_STATIC_ACCESS='::'
    T_ASTERISK='*'
    T_ALTERNATION='|'
    T_NEGATION='!'
    T_LOGICAL_AND='&&'
    T_LOGICAL_OR='||'
    T_DOUBLE_ASTERISK='**'
    T_SUBNAMESPACE_SIGN='+'
    T_COLON=':'
    T_QUESTION_MARK='?'
    T_AMPERSAND='&'
    PRIVATE_SET='private(set)'
    PROTECTED_SET='protected(set)'
    T_THIS='$this'
    T_COMMENT='regexp://.*'
    T_LINE_WS='regexp:[\ \t\f]'
    T_NAME_PART='regexp:[a-zA-Z_\x7f-\xff][a-zA-Z0-9_\x7f-\xff]*'
  ]
}
pointcutFile ::= pointcutExpression;

pointcutExpression ::=
    (conjugatedExpression '||' pointcutExpression)
  | conjugatedExpression;

conjugatedExpression ::=
    (negatedExpression '&&' conjugatedExpression)
  | negatedExpression;

negatedExpression ::=
    brakedExpression
  | '!' brakedExpression;

brakedExpression ::=
    singlePointcut
  | '(' pointcutExpression ')';


singlePointcut ::=
    accessPointcut
  | annotatedAccessPointcut
  | executionPointcut
  | annotatedExecutionPointcut
  | withinPointcut
  | annotatedWithinPointcut
  | initializationPointcut
  | staticInitializationPointcut
  | matchInheritedPointcut
  | matchReturningByReferencePointcut
  | cflowbelowPointcut
  | dynamicExecutionPointcut
  | pointcutReference;

accessPointcut ::= access '(' memberReference ')'

executionPointcut ::=
    execution '(' methodExecutionReference ')'
  | execution '(' functionExecutionReference ')'

withinPointcut ::= within '(' classFilter ')'

annotatedAccessPointcut ::= ('@' access '(' namespaceName ')')

annotatedExecutionPointcut ::= ('@' execution '(' namespaceName ')')

annotatedWithinPointcut ::= ('@' within '(' namespaceName ')')

initializationPointcut ::= (initialization '(' classFilter ')')

staticInitializationPointcut ::= (staticinitialization '(' classFilter ')')

matchInheritedPointcut ::= (matchInherited '(' ')');

matchReturningByReferencePointcut ::= (matchReturningByReference '(' ')');

// Removed in Go! AOP 4.0: still parsed, so that the annotator can explain the migration
cflowbelowPointcut ::= (cflowbelow '(' executionPointcut ')');

// Removed in Go! AOP 4.0: still parsed, so that the annotator can explain the migration
dynamicExecutionPointcut ::= (dynamic '(' memberReference '(' argumentList ')' ')');

pointcutReference ::= ((namespaceName | '$this') '->' namePatternPart);

methodExecutionReference ::= (memberReference '(' argumentList ')' (':' returnTypePattern)?);

functionExecutionReference ::= (namespacePattern '(' argumentList ')' (':' returnTypePattern)?);

memberReference ::= (memberModifiers classFilter memberAccessType namePattern);

// Union ('|') and intersection ('&') members, DNF groups are written without parentheses: 'A&B|C'.
// A leading '?' is the nullable marker of a single type: '?Foo' equals 'Foo|null'.
returnTypePattern ::= ('?' namespaceName) | (returnTypeMember {'|' returnTypeMember}*);

private returnTypeMember ::= namespaceName {'&' namespaceName}*;

classFilter ::= namespacePattern '+'?;

argumentList ::= '*';

memberAccessType ::= ['::'|'->'] {methods=[getMemberAccessType]};

namespacePattern ::= namespacePatternPart {'\' namespacePatternPart}*;

namePattern ::= namePatternPart;

namespacePatternPart ::= namePatternPart|'**';

// '|' alternatives stay inside their name part: 'Ns\A|B' is 'Ns\A' or 'Ns\B'
namePatternPart ::= namePatternItem+ {'|' namePatternItem+}*;

private namePatternItem ::= '*'|T_NAME_PART;

namespaceName ::= T_NAME_PART {'\' T_NAME_PART}* {methods=[getFQN]}

// Space-separated modifier groups must all match, '|' alternatives inside a group bind tighter:
// 'final public|protected' is final AND (public OR protected)
memberModifiers ::= modifierGroup+

modifierGroup ::= memberModifier {'|' memberModifier}*

memberModifier ::= private|protected|public|final|readonly|'private(set)'|'protected(set)'

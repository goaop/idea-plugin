<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.aopphp.go.framework</id>
    <name>Go! AOP Framework</name>
    <vendor email="lisachenko.it@gmail.com" url="https://go.aopphp.com">Go! AOP Framework</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Go! AOP Pointcut"
                  implementationClass="com.aopphp.go.GoAopFileType"
                  fieldName="INSTANCE"
                  language="Go! AOP Pointcut query"
                  extensions="goaop"/>

        <lang.parserDefinition language="Go! AOP Pointcut query"
                               implementationClass="com.aopphp.go.PointcutQueryParserDefinition"/>

        <lang.syntaxHighlighterFactory key="Go! AOP Pointcut query"
                                       implementationClass="com.aopphp.go.PointcutQuerySyntaxHighlighterFactory"/>

        <colorSettingsPage implementation="com.aopphp.go.PointcutQueryColorSettingsPage"/>

        <completion.contributor language="Go! AOP Pointcut query"
                                implementationClass="com.aopphp.go.PointcutCompletionContributor"/>

        <lang.braceMatcher language="Go! AOP Pointcut query"
                           implementationClass="com.aopphp.go.PointcutQueryPairedBraceMatcher"/>

        <multiHostInjector implementation="com.aopphp.go.injector.PointcutQueryLanguageInjector"/>
        <multiHostInjector implementation="com.aopphp.go.injector.PhpDealAssertInjector"/>

        <annotator language="Go! AOP Pointcut query"
                   implementationClass="com.aopphp.go.annotator.AttributeAnnotator"/>
        <annotator language="Go! AOP Pointcut query"
                   implementationClass="com.aopphp.go.annotator.PointcutAnnotator"/>

        <codeInsight.lineMarkerProvider language="PHP"
                                        implementationClass="com.aopphp.go.line.marker.AdvisedElementsLineMarkerProvider"/>
        <codeInsight.lineMarkerProvider language="PHP"
                                        implementationClass="com.aopphp.go.line.marker.AdvisorLineMarkerProvider"/>

        <fileBasedIndex implementation="com.aopphp.go.index.AttributePointcutExpressionIndex"/>

        <psi.referenceContributor language="Go! AOP Pointcut query"
                                  implementation="com.aopphp.go.reference.PointcutClassReferenceContributor"/>

        <psi.referenceContributor language="PHP"
                                  implementation="com.aopphp.go.reference.PointcutPhpReferenceContributor"/>

        <referencesSearch implementation="com.aopphp.go.reference.PointcutReferencesSearcher"/>

        <useScopeEnlarger implementation="com.aopphp.go.reference.PointcutUseScopeEnlarger"/>

        <usageTypeProvider implementation="com.aopphp.go.reference.PointcutUsageTypeProvider"/>

        <typedHandler implementation="com.aopphp.go.typing.PointcutMemberAccessTypingHandler"/>

        <gotoDeclarationHandler implementation="com.aopphp.go.reference.PointcutGotoDeclarationHandler"/>

        <lang.documentationProvider language="Go! AOP Pointcut query"
                                    implementationClass="com.aopphp.go.reference.PointcutDocumentationProvider"/>

        <iconProvider implementation="com.aopphp.go.provider.AspectIconProvider" order="first"/>

        <localInspection language="PHP" shortName="GoAopAdviceMethod" groupName="Go! AOP"
                         displayName="Invalid advice method"
                         enabledByDefault="true" level="ERROR"
                         implementationClass="com.aopphp.go.inspection.AdviceMethodInspection"/>
        <localInspection language="PHP" shortName="GoAopRemovedAttribute" groupName="Go! AOP"
                         displayName="Attribute removed in Go! AOP 4.0"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="com.aopphp.go.inspection.RemovedAttributeInspection"/>
        <localInspection language="PHP" shortName="GoAopReturningByReference" groupName="Go! AOP"
                         displayName="Advised method returns by reference"
                         enabledByDefault="true" level="WARNING"
                         implementationClass="com.aopphp.go.inspection.ReturningByReferenceInspection"/>
    </extensions>
</idea-plugin>
